# Python caches
__pycache__/
*.py[cod]

# Generated package and build files
*.egg-info/
build/
dist/

# Virtual environments
.venv/
venv/

# Notebook checkpoints
.ipynb_checkpoints/

# PBS standard output and error logs
*.o[0-9]*
*.e[0-9]*

